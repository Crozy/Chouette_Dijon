# ─── DIJON HUB — configuration ───────────────────────────────────────────────
# Copiez ce fichier en .env. Toute clé absente → la source bascule en mode SIMULÉ.

# Port exposé par docker compose
DIJONHUB_PORT=8080

# --- Trains SNCF (API Navitia) : clé gratuite sur https://numerique.sncf.com/startup/api/
SNCF_API_KEY=

# --- Circulation temps réel : clé gratuite sur https://developer.tomtom.com (produit « Traffic API »)
# Vide → circulation ESTIMÉE selon l'heure (marquée « simulé »)
TOMTOM_API_KEY=

# --- Cars : horaires théoriques officiels FlixBus / BlaBlaCar Bus (GTFS open data, sans clé)
# FLIXBUS_GTFS_URL=https://www.data.gouv.fr/api/1/datasets/r/30d94e83-48a4-4c44-8a96-c082377f5221
# BLABLACAR_GTFS_URL=https://www.data.gouv.fr/api/1/datasets/r/fd54f81f-4389-4e73-be75-491133d011c3

# --- Vélodi : URL d'auto-découverte GBFS (gbfs.json) si vous en disposez
VELODI_GBFS_URL=

# --- Divia (valeurs par défaut = flux officiels transport.data.gouv.fr)
# DIVIA_GTFS_RT_VEHICLES_URL=https://proxy.transport.data.gouv.fr/resource/divia-dijon-gtfs-rt-vehicle-position
# DIVIA_GTFS_STATIC_URL=https://www.data.gouv.fr/api/1/datasets/r/e0dbd217-15cd-4e28-9459-211a27511a34
# Flux GTFS-RT « service alerts » (optionnel)
DIVIA_GTFS_RT_ALERTS_URL=

# --- Événements : https://openagenda.com (clé API + identifiant d'agenda)
OPENAGENDA_KEY=
OPENAGENDA_AGENDA_UID=

# --- Presse locale : "Nom|URL,Nom|URL"
# RSS_FEEDS=Le Bien Public|https://www.bienpublic.com/edition-dijon-ville/rss,ici Bourgogne|https://www.francebleu.fr/rss/bourgogne/a-la-une.xml,Ville de Dijon|https://www.dijon.fr/rss

# --- Réseaux sociaux : "@Compte|URL d'un flux RSS/Atom" (Mastodon, RSS-Bridge, Nitter…)
# Exemple Mastodon : @compte|https://instance.example/@compte.rss
SOCIAL_FEEDS=

# --- Divers
CORS_ORIGINS=*
# Force toutes les sources en mode simulé (démonstration hors-ligne)
FORCE_DEMO=false
